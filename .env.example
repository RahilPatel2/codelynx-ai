# ==========================================
# CODELYNX AI - Environment Configuration
# ==========================================

# 1. APPLICATION
APP_URL=http://localhost:3000
NODE_ENV=development
AUTH_SECRET=codelynx-ai-super-secret-production-key-at-least-32-chars

# 2. DATABASE (MongoDB Atlas)
# Optional in development (application runs with in-memory sandbox and sample seed projects).
# Add your Atlas connection string to persist users, projects, and executions.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=codelynx

# 3. AI SERVICES (Google Gemini / Vertex AI)
# Encapsulated behind an AI interface. If not provided, CodeLynx operates using its
# built-in deterministic heuristic analysis and offline AST verification engine.
GEMINI_API_KEY=
GEMINI_API_MODEL=gemini-2.5-flash
# Optional Google Cloud Vertex AI settings:
# GOOGLE_CLOUD_PROJECT_ID=
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=

# 4. REMOTE CODE EXECUTION (Judge0 CE / RapidAPI)
# Encapsulated behind execution provider adapter.
# If unconfigured, CodeLynx safely executes and analyzes code via its local isolated sandbox simulator.
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# 5. GOOGLE OAUTH (Optional sign-in integration)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
